{
  "entities": {
    "User": {
      "title": "User",
      "description": "Represents a user in the system (Patient or Doctor).",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "role": { "type": "string", "enum": ["patient", "doctor"] },
        "onboardingComplete": { "type": "boolean" },
        "age": { "type": "string" },
        "gender": { "type": "string" },
        "bloodGroup": { "type": "string" },
        "address": { "type": "string" },
        "degree": { "type": "string" },
        "sharingEnabled": { "type": "boolean" }
      },
      "required": ["id", "name", "email", "role"]
    },
    "MedicalRecord": {
      "title": "Medical Record",
      "description": "A medical document uploaded by a patient.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "patientId": { "type": "string" },
        "fileUrl": { "type": "string", "format": "uri" },
        "fileName": { "type": "string" },
        "type": { "type": "string", "enum": ["prescription", "report"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "patientId", "fileUrl", "type", "createdAt"]
    },
    "Reminder": {
      "title": "Reminder",
      "description": "A health reminder for a user.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "time": { "type": "string" },
        "type": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "title", "time"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "Storage for user profiles."
    },
    "/records/{recordId}": {
      "schema": "MedicalRecord",
      "description": "Global collection of medical records."
    },
    "/reminders/{reminderId}": {
      "schema": "Reminder",
      "description": "User specific health reminders."
    }
  }
}
